# ==============================================================================
# VIVU PLANNER - BIEN MOI TRUONG TONG QUAN CHO MONOREPO / VERCEL (.env.example)
# ==============================================================================
# LUU Y: Gemini API key duoc quan ly qua bang gemini_api_keys trong Supabase,
# admin tu them qua giao dien quan tri tai /admin/keys, KHONG can khai bao trong bien moi truong.

# [SUPABASE] Dung chung cho ca Frontend va Backend
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# [FRONTEND] Bien client-side bat buoc tien to EXPO_PUBLIC_
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
EXPO_PUBLIC_API_BASE_URL=/api

# [BACKEND] Cau hinh Express server
PORT=4000
FRONTEND_URL=https://vivu-planner.vercel.app
SITE_URL=https://vivu-planner.vercel.app

# [THANH TOAN PAYOS] Tuy chon
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# [THANH TOAN MOMO] Tuy chon
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# [GMAIL SMTP - QUEN MAT KHAU & GUI OTP] Bat buoc neu dung tinh nang Quen Mat Khau
GMAIL_USER=
GMAIL_APP_PASSWORD=

# [CAU HINH AI - VERCEL ENVIRONMENT VARIABLES]
# Chon provider: 'custom_openai' (Cổng AI Pro / Gateway) hoac 'gemini' (Google Gemini mac dinh)
AI_PROVIDER=custom_openai
CUSTOM_AI_BASE_URL=https://api.your-gateway.com/v1
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=gemini-3.8-flash-high
CUSTOM_AI_MAX_TOKENS=50000
GEMINI_MAX_TOKENS=8192

