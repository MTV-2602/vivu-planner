# ==============================================================================
# VIVU PLANNER BACKEND - MAU BIEN MOI TRUONG (.env.example)
# ==============================================================================
# LUU Y: Gemini API key duoc quan ly qua bang gemini_api_keys trong Supabase,
# admin tu them qua giao dien quan tri tai /admin/keys, KHONG can khai bao trong bien moi truong.

# --- 1. CAU HINH SERVER & CORS ---
PORT=4000
FRONTEND_URL=http://localhost:8081
SITE_URL=https://vivu-planner.vercel.app

# --- 2. CO SO DU LIEU & XAC THUC (SUPABASE) - [BAT BUOC] ---
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- 3. CONG THANH TOAN PAYOS (VIETQR) - [TUY CHON] ---
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here

# --- 4. CONG THANH TOAN MOMO - [TUY CHON] ---
MOMO_PARTNER_CODE=your_momo_partner_code_here
MOMO_ACCESS_KEY=your_momo_access_key_here
MOMO_SECRET_KEY=your_momo_secret_key_here
