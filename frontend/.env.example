# ==============================================================================
# VIVU PLANNER FRONTEND (EXPO) - MAU BIEN MOI TRUONG (.env.example)
# ==============================================================================

# URL du an Supabase (Tien to EXPO_PUBLIC_ de Expo bundle vao app)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Khoa cong khai Anon cua Supabase (TUYET DOI khong de Service Role Key o day)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Base URL cua Backend API (Mac dinh: /api cho Monorepo Vercel, hoac http://localhost:4000/api cho local rieng)
EXPO_PUBLIC_API_BASE_URL=/api

# Cloudflare Turnstile Site Key cho chuc nang bao ve dang ky va dang nhap (Public Site Key)
# Luu y: Framework su dung Expo (Metro bundler), bien client bat buoc su dung tien to EXPO_PUBLIC_.
# QUAN TRONG: Chi dung Site Key tao tu Cloudflare Dashboard cho domain production (https://vivu-planner.vercel.app).
# TUYET DOI KHONG su dung testing key luon pass (1x00000000000000000000AA) tren moi truong Production.
EXPO_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
